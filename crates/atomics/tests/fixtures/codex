#!/usr/bin/python3
"""Busy Codex with placeholders, clipped receipts, and dropped input."""
import os
import sys
import tty

if "--version" in sys.argv:
    print("codex-cli 0.164.0")
    sys.exit(0)

mode = sys.argv[sys.argv.index("--mode") + 1] if "--mode" in sys.argv else "queue"
tty.setraw(sys.stdin.fileno())
text = b""
paste = False
sequence = b""
enters = 0
pastes = 0
tabs = 0
placeholder = "" if mode == "drop-empty" else "Ask Codex to do anything"
previous = "Please check the first change and then the second change"
last_body = ""


def screen(body):
    global last_body
    last_body = body
    sys.stdout.write(
        "\x1b[2J\x1b[H\x1b[?2004h" + body
        + "\r\nPastes: " + str(pastes) + "\r\nEnters: " + str(enters)
        + "\r\nTabs: " + str(tabs)
    )
    sys.stdout.flush()


menu = "Would you like to run the following command?\r\n\r\n  $ touch fixture\r\n\r\n› 1. Yes, proceed (y)\r\n  2. No, and tell Codex what to do differently (esc)\r\nPress enter to confirm or esc to cancel"
hidden = "Would you like to run the following command?\r\n\r\nReason: A long explanation of why access is needed\r\n  [… 9 lines] ⌃a view all\r\n\r\n› 1. Yes, proceed (y)\r\n  2. No, and tell Codex what to do differently (esc)\r\nPress enter to confirm or esc to cancel"
initial = "Working (esc to interrupt)\r\n› " + placeholder + "\r\n tab to queue"
if mode == "repeat":
    initial = "• " + previous + "\r\n" + initial
screen(hidden if mode == "hidden" else initial)
while True:
    char = os.read(sys.stdin.fileno(), 1)
    if not char:
        break
    if mode == "hidden":
        if char == b"\x01":
            screen(menu)
        elif char == b"1":
            screen("Approved\r\nWorking (esc to interrupt)\r\n› ")
        continue
    if sequence or char == b"\x1b":
        sequence += char
        if sequence == b"\x1b[200~":
            pastes += 1
            paste = True
            text = b""
            sequence = b""
        elif sequence == b"\x1b[201~":
            paste = False
            sequence = b""
            composer = "[Pasted Content " + str(len(text)) + " chars]" if mode in ("long", "collapsed", "marker") else text.decode()
            if mode in ("drop-paste", "drop-empty"):
                text = b""
                composer = placeholder
            footer = "" if mode == "retry" else "\r\n tab to queue"
            screen("Working (esc to interrupt)\r\n› " + composer + footer)
        continue
    if paste:
        text += char
    elif char == b"\r":
        enters += 1
        if mode == "exit":
            sys.exit(0)
        if mode == "retry" and enters > 1:
            screen("› " + text.decode() + "\r\nWorking (esc to interrupt)\r\n› " + placeholder)
        elif mode == "long":
            screen("• " + text.decode().splitlines()[-1] + "\r\nWorking (esc to interrupt)\r\n› " + placeholder)
        elif mode == "marker":
            screen("Message accepted\r\nWorking (esc to interrupt)\r\n› " + placeholder)
        elif mode == "repeat":
            screen("• " + previous + "\r\n• " + text.decode() + "\r\nWorking (esc to interrupt)\r\n› " + placeholder)
        elif mode == "preview":
            screen("• " + text[:24].decode() + "…\r\nQueued\r\n› " + placeholder)
        elif mode == "no-prompt":
            screen("Message accepted\r\nWorking (esc to interrupt)")
        screen(last_body)
    elif char == b"\t":
        tabs += 1
        if mode in ("queue", "collapsed"):
            screen("• " + text.decode() + "\r\nQueued\r\n› " + placeholder + "\r\n esc to interrupt")
        else:
            screen(last_body)
