# ATOMICS runs natively on a Mac (Metal) and starts its agents and chief in this VM over ssh.
# One definition generates both sides: the guest's shares, socket folder and Linux `atomics` at
# the Mac's paths, and the Mac's wrappers, opt-in socket forward, Lima definition and config snippet.
# The forward is off unless the Mac user starts it: it carries ATOMICS's whole control API and
# makes this VM as trusted as the Mac account (docs/nixos-vm.md, The socket forward).
{ config, lib, pkgs, ... }:

let
  inherit (lib) mkEnableOption mkOption types;

  atomics = config.programs.atomics;
  cfg = atomics.macDesktop;
  vmUser = config.users.users.${atomics.user} or null;
  vmGroup = if vmUser == null || vmUser.group == "" then "users" else vmUser.group;
  yaml = pkgs.formats.yaml { };

  shares = lib.mapAttrsToList (path: share: { inherit path; inherit (share) writable; }) cfg.shares;
  within = parent: path: path == parent || lib.hasPrefix "${parent}/" path;
  inShare = path: lib.any (share: within share.path path) shares;
  # Paths travel through sshd, cloud-init and tmpfiles lines unquoted.
  plainPath = path: builtins.match "/[A-Za-z0-9._@+/-]+" path != null && !(lib.hasSuffix "/" path);
  parents = path:
    let parts = lib.filter (part: part != "") (lib.splitString "/" path);
    in map (n: "/" + lib.concatStringsSep "/" (lib.take n parts)) (lib.range 1 (lib.length parts - 1));
  # The Mac home belongs to the VM user. Other folders are made if missing, never re-moded:
  # an ancestor may be /tmp or another system folder.
  ownedDir = dir:
    if within cfg.home dir then "d ${dir} 0755 ${atomics.user} ${vmGroup} - -" else "d ${dir} - - - - -";

  execPath = "/run/current-system/sw/bin/atomics-vm-exec";
  sshConfig = ''"''${LIMA_HOME:-$HOME/.lima}/${cfg.lima.instance}/ssh.config"'';
  host = "lima-${cfg.lima.instance}";
  envName = name: builtins.match "[A-Za-z_][A-Za-z0-9_]*" name != null;

  # The guest half of every wrapper: decode the fields, enter the folder, run through a login shell.
  vmExec = pkgs.writeShellApplication {
    name = "atomics-vm-exec";
    runtimeInputs = [ pkgs.coreutils ];
    text = ''
      # Called over ssh by the Mac wrappers that programs.atomics.macDesktop generates.
      # Fields (NUL-separated, base64): format 1, folder, NAME=value..., --, program, arguments.
      stage="''${XDG_RUNTIME_DIR:-/tmp}/atomics-vm-exec"
      fail() { printf 'atomics-vm: %s\n' "$*" >&2; exit 64; }
      case "''${1-}" in
        --stage)
          # Arguments too long for one ssh command line arrive on stdin first.
          umask 077
          mkdir -p "$stage"
          file=$(mktemp "$stage/payload.XXXXXXXXXX")
          cat >"$file"
          printf '%s\n' "''${file##*/}"
          exit 0
          ;;
        --staged)
          [[ ''${2-} =~ ^payload\.[A-Za-z0-9]+$ ]] || fail "bad staged payload name"
          payload=$(<"$stage/$2")
          rm -f -- "''${stage:?}/$2"
          ;;
        *)
          payload=''${1-}
          ;;
      esac
      fields=()
      mapfile -d "" -t fields < <(printf '%s' "$payload" | base64 -d)
      [[ ''${#fields[@]} -ge 3 && ''${fields[0]} == 1 ]] ||
        fail "unreadable request; rebuild the Mac wrappers with this VM's flake (atomics-vm-mac)"
      folder=''${fields[1]}
      assignments=()
      i=2
      while [[ $i -lt ''${#fields[@]} && ''${fields[i]} != -- ]]; do
        [[ ''${fields[i]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || fail "bad environment entry"
        assignments+=("''${fields[i]}")
        i=$((i + 1))
      done
      [[ $i -lt ''${#fields[@]} ]] || fail "unreadable request"
      argv=("''${fields[@]:i+1}")
      if ! cd -- "$folder" 2>/dev/null; then
        printf 'atomics-vm: %s is not in this VM. It mounts these Mac folders at the same paths:%s\n' \
          "$folder" "${lib.concatMapStrings (share: " ${share.path}") shares}" >&2
        exit 66
      fi
      [[ ''${#argv[@]} -gt 0 ]] || argv=("''${SHELL:-bash}" -l)
      # A login shell gives agents the same PATH and variables as an interactive session here.
      exec "$BASH" --login -c 'exec env "$@"' atomics-vm "''${assignments[@]}" "''${argv[@]}"
    '';
  };

  # The Mac half: POSIX sh and macOS's own ssh, base64 and tr, so no Nix is needed there.
  # The fields of `$folder` and the arguments, as one shell-safe word; `indent` aligns its lines.
  encode = indent: lib.concatStringsSep "\n${indent}" ([
    "payload=$("
    "  {"
    "    printf '%s\\0' 1 \"$folder\""
  ] ++ map (name: "    [ -z \"\${${name}+set}\" ] || printf '%s\\0' \"${name}=\$${name}\"") cfg.forwardEnv ++ [
    "    printf '%s\\0' --"
    "    [ \"$#\" -eq 0 ] || printf '%s\\0' \"$@\""
    "  } | base64 | tr -d '\\n'"
    ")"
  ]);
  preamble = ''
    #!/bin/sh
    # Generated by the ATOMICS flake (programs.atomics.macDesktop); rebuild it rather than edit it.
    set -eu
    ssh_config=${sshConfig}
    if [ ! -r "$ssh_config" ]; then
      echo "atomics-vm: no Lima instance ${cfg.lima.instance} ($ssh_config); see docs/nixos-vm.md" >&2
      exit 69
    fi
  '';
  sshOptions = lib.concatStringsSep " " [
    ''-F "$ssh_config"''
    "-o LogLevel=ERROR"
    # A private connection: a shared master would carry its own keystroke timing.
    "-o ControlMaster=no"
    "-o ControlPath=none"
    "-o ServerAliveInterval=15"
    "-o ServerAliveCountMax=4"
  ];
  runScript = { program ? null, description }: preamble + ''
    # ${description}
    ${lib.optionalString (program != null) "set -- ${lib.escapeShellArg program} \"$@\""}
    folder=$(pwd)
    ${encode ""}
    if [ -t 0 ]; then tty=-tt; else tty=-T; fi
    # -e none: no escape character in a session that carries arbitrary keystrokes.
    # ObscureKeystrokeTiming=no: OpenSSH 9.5+ otherwise sends keystrokes on a 20 ms clock.
    set -- ${sshOptions} -e none -o ObscureKeystrokeTiming=no ${host}
    # One sshd command line holds about 128 KiB; longer requests are staged first.
    if [ "''${#payload}" -le 100000 ]; then
      exec ssh "$tty" "$@" exec ${execPath} "$payload"
    fi
    token=$(printf '%s' "$payload" | ssh -T "$@" exec ${execPath} --stage)
    exec ssh "$tty" "$@" exec ${execPath} --staged "$token"
  '';

  forwardScript = preamble + ''
    # Forwards ATOMICS's control socket into the VM at the same path, so hooks, MCP servers and
    # `atomics ctl` there reach ATOMICS here. Runs until the VM goes away; launchd restarts it.
    # Opt-in: the socket carries the whole control API (start agents, including a shell on this
    # Mac, type into and approve any session), so every process in the VM can then act as you here.
    # Arguments name other sockets (an instance with its own ATOMICS_SOCKET); default:
    [ "$#" -gt 0 ] || set -- ${lib.escapeShellArg cfg.socket}
    for socket; do
      case $socket in
        *:*) echo "atomics-vm-forward: $socket contains ':'" >&2; exit 64 ;;
        /*) ;;
        *) echo "atomics-vm-forward: $socket is not an absolute path" >&2; exit 64 ;;
      esac
    done
    # sshd binds a socket only in an existing folder.
    (
      for socket; do set -- "$@" "''${socket%/*}"; done
      shift "$(( $# / 2 ))"
      set -- mkdir -p -m 0700 -- "$@"
      folder=/
      ${encode "  "}
      ssh -T ${sshOptions} ${host} exec ${execPath} "$payload"
    )
    count=$#
    for socket; do set -- "$@" -R "$socket:$socket"; done
    shift "$count"
    exec ssh -N -T ${sshOptions} -o ExitOnForwardFailure=yes "$@" ${host}
  '';

  # The ATOMICS host in the VM (atomics.vm.host): its protocol server listens on the guest's loopback
  # only, and this forward reaches it from the Mac through Lima's ssh. Clients still need the token
  # they paired with (`atomics ctl '{"cmd":"pair_client",...}'` in the guest).
  hostForwardScript = preamble + ''
    # Holds a forward from this Mac to the ATOMICS host in the VM until the VM goes away.
    # ATOMICS.app runs it while it shows the VM's host, with a Unix socket (an absolute path) in a
    # folder only you can enter, and sends its token there alone: on a port of this Mac's loopback,
    # whatever listened there first would get it, another account's program among them. A port
    # instead opens that port on this Mac's loopback; it defaults to the guest's.
    listen=''${1:-${toString cfg.hostPort}}
    case $listen in
      /*:*) echo "atomics-vm-host-forward: $listen contains ':'" >&2; exit 64 ;;
      /*) ;;
      ""|*[!0-9]*) echo "atomics-vm-host-forward: $listen is not a port or an absolute socket path" >&2; exit 64 ;;
      *) listen=127.0.0.1:$listen ;;
    esac
    # A socket a forward of this window's left behind is replaced; its folder holds nothing else.
    exec ssh -N -T ${sshOptions} -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes \
      -L "$listen:127.0.0.1:${toString cfg.hostPort}" ${host}
  '';

  # Codex's browser sign-in, for ChatGPT accounts that refuse device codes: `codex login` in the
  # guest waits on its loopback port 1455 for the browser's return, which this forwards from the Mac
  # while it runs (docs/nixos-vm.md, Sign in inside the VM).
  codexLoginScript = preamble + ''
    # Signs Codex in inside the VM ${cfg.lima.instance} through this Mac's browser: open the address
    # it prints. Port 1455 of this Mac's loopback reaches the VM until the sign-in ends.
    if [ -t 0 ]; then tty=-tt; else tty=-T; fi
    exec ssh "$tty" ${sshOptions} -o ExitOnForwardFailure=yes \
      -L 127.0.0.1:1455:127.0.0.1:1455 ${host} \
      "exec /run/current-system/sw/bin/bash --login -c 'umask 077; exec codex login'"
  '';

  tomlValue = value:
    if builtins.isList value then "[${lib.concatMapStringsSep ", " tomlValue value}]" else builtins.toJSON value;
  # Fields in the order a person reads them; null leaves one out.
  tomlTable = header: fields:
    "${header}\n" + lib.concatMapStrings (field: lib.optionalString (field.value != null) "${field.key} = ${tomlValue field.value}\n") fields;
  agentTable = { name, command, kind, busyText ? null }: tomlTable "[[agents]]" [
    { key = "name"; value = name; }
    { key = "command"; value = command; }
    { key = "kind"; value = kind; }
    { key = "busy_text"; value = busyText; }
    { key = "isolation"; value = "bare"; }
  ];
  wrapperAgent = program: agentTable ({
    name = program;
    command = [ "${cfg.installDir}/bin/${program}" ];
    kind = if program == "claude" then "claude" else "generic";
  } // lib.optionalAttrs (program == "codex") { busyText = "esc to interrupt"; });
  configSnippet = if cfg.hostPort != null then hostConfigSnippet else wrapperConfigSnippet;
  # The host in the VM runs everything; this Mac's ATOMICS only shows it.
  hostConfigSnippet = ''
    # ATOMICS on this Mac shows the ATOMICS host in the Lima VM ${cfg.lima.instance}: agents, the chief,
    # hooks, git and builds run there, and this Mac draws the window (docs/nixos-vm.md).
    [client]
    connect = "vm"
  '';
  wrapperConfigSnippet = ''
    # ATOMICS on this Mac with its agents and chief in the Lima VM ${cfg.lima.instance}.
    # Copy into ~/.config/atomics/config.d/<this Mac's host name>.toml: a host file's agents
    # list replaces the main file's. The VM is the agents' boundary, so they run bare.

  '' + lib.concatMapStrings (program: wrapperAgent program + "\n") cfg.agents + ''
    # A login shell in the VM, in the same folder.
  '' + agentTable { name = "shell"; command = [ "${cfg.installDir}/bin/atomics-vm-run" ]; kind = "shell"; } + ''

    # A shell on this Mac.
  '' + agentTable { name = "mac-shell"; command = [ ]; kind = "shell"; }
  + lib.optionalString (lib.elem "claude" cfg.agents)
    ("\n" + tomlTable "[chief]" [ { key = "command"; value = [ "${cfg.installDir}/bin/claude" ]; } ])
  + ''

    [isolation]
    # This Mac's credential relay listens on its own loopback, which the VM cannot reach.
    # Agents and the chief sign in inside the VM instead.
    bare_relay = false
  '';

  launchdLabel = "ai.atomisk.atomics.vm-forward.${cfg.lima.instance}";
  plist = ''
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>Label</key>
      <string>${launchdLabel}</string>
      <key>ProgramArguments</key>
      <array>
        <string>${cfg.installDir}/bin/atomics-vm-forward</string>
      </array>
      <key>RunAtLoad</key>
      <true/>
      <key>KeepAlive</key>
      <true/>
      <key>ThrottleInterval</key>
      <integer>30</integer>
      <key>StandardErrorPath</key>
      <string>${cfg.home}/Library/Logs/atomics-vm-forward.log</string>
    </dict>
    </plist>
  '';

  installScript = ''
    #!/bin/sh
    # Installs this bundle at ${cfg.installDir}, where its launchd agent and config snippet expect it.
    set -eu
    source=$(cd -- "$(dirname -- "$0")" && pwd -P)
    target=${lib.escapeShellArg cfg.installDir}
    if [ "$source" != "$target" ]; then
      mkdir -p -- "$(dirname -- "$target")"
      rm -rf -- "$target.new"
      cp -R -- "$source" "$target.new"
      # BSD chmod reads its mode before options end, so no `--` here.
      chmod -R u+w "$target.new"
      rm -rf -- "$target"
      mv -- "$target.new" "$target"
    fi
    # Lima shares only folders that exist.
    ${lib.concatMapStrings (share: "mkdir -p -- ${lib.escapeShellArg share.path}\n") shares}
    cat <<EOF
    Installed in $target. Next:
      limactl create --name=${cfg.lima.instance} --set='.images[0].location = "/absolute/path/to/atomics-vm.raw"' $target/lima.yaml
      limactl start ${cfg.lima.instance}
    and copy $target/config.d.toml into ~/.config/atomics/config.d/\$(scutil --get LocalHostName).toml.
    The control socket stays on this Mac. Forwarding it gives the VM's hooks, MCP and ctl access,
    and every process in the VM the power to run commands here as you (docs/nixos-vm.md):
      launchctl bootstrap gui/\$(id -u) $target/launchd/${launchdLabel}.plist
    EOF
  '';

  limaDefinition = lib.recursiveUpdate cfg.lima.settings {
    user = {
      name = atomics.user;
      uid = vmUser.uid;
      home = vmUser.home;
      shell = "/run/current-system/sw/bin/bash";
    };
    # Not plain mode, which drops mounts. Lima's boot scripts stay unused; its guest agent runs.
    plain = false;
    mountType = "virtiofs";
    mounts = map (share: { location = share.path; mountPoint = share.path; inherit (share) writable; }) shares;
    # The VM's ports stay in the VM, as in plain mode: no guest listener appears on the Mac's
    # loopback, where a container's published port would shadow the Mac's own. A rule for 0.0.0.0
    # matches only listeners on every address; Lima's default would forward the guest's loopback
    # ones (the ATOMICS host's among them, which the bundle's own forward carries instead).
    portForwards = map (guestIP: { inherit guestIP; guestPortRange = [ 1 65535 ]; proto = "any"; ignore = true; })
      [ "127.0.0.1" "0.0.0.0" ];
  };

  # What `atomics vm` on the Mac reads about this VM (crates/atomics/src/vm.rs, BundleInfo).
  bundleInfo = builtins.toJSON ({
    version = 1;
    instance = cfg.lima.instance;
    user = atomics.user;
    home = vmUser.home;
    macUser = cfg.user;
    installDir = cfg.installDir;
  } // lib.optionalAttrs (cfg.hostPort != null) {
    host.port = cfg.hostPort;
  });

  textFile = name: text: executable: pkgs.writeTextFile { inherit name text executable; };
  bundle = pkgs.runCommand "atomics-vm-mac" {
    nativeBuildInputs = [ pkgs.shellcheck ];
    passthru = { inherit vmExec; };
  } ''
    mkdir -p $out/bin $out/launchd
    ${lib.concatMapStrings (program: ''
      install -m 0755 ${textFile "atomics-vm-${program}" (runScript {
        inherit program;
        description = "Runs ${program} in the VM ${cfg.lima.instance}, in this folder; ATOMICS starts it as an agent.";
      }) true} $out/bin/${program}
    '') cfg.agents}
    install -m 0755 ${textFile "atomics-vm-run" (runScript {
      description = "Runs a command in the VM ${cfg.lima.instance}, in this folder; with none, a login shell.";
    }) true} $out/bin/atomics-vm-run
    install -m 0755 ${textFile "atomics-vm-forward" forwardScript true} $out/bin/atomics-vm-forward
    ${lib.optionalString (cfg.hostPort != null) ''
      install -m 0755 ${textFile "atomics-vm-host-forward" hostForwardScript true} $out/bin/atomics-vm-host-forward
    ''}
    ${lib.optionalString (lib.elem "codex" cfg.agents) ''
      install -m 0755 ${textFile "atomics-vm-codex-login" codexLoginScript true} $out/bin/atomics-vm-codex-login
    ''}
    install -m 0755 ${textFile "atomics-vm-install" installScript true} $out/install.sh
    install -m 0644 ${textFile "atomics-vm-config" configSnippet false} $out/config.d.toml
    install -m 0644 ${textFile "atomics-vm-plist" plist false} $out/launchd/${launchdLabel}.plist
    install -m 0644 ${yaml.generate "lima.yaml" limaDefinition} $out/lima.yaml
    install -m 0644 ${textFile "atomics-vm.json" bundleInfo false} $out/atomics-vm.json
    shellcheck --shell=sh $out/bin/* $out/install.sh
  '';
in
{
  options.programs.atomics.macDesktop = {
    enable = mkEnableOption ''
      agents for ATOMICS running natively on a Mac. ATOMICS starts its agents and chief in this
      machine over ssh, in the same folders, which this machine mounts from the Mac at the same paths
    '';

    user = mkOption {
      type = types.str;
      example = "alice";
      description = "Account name on the Mac.";
    };

    home = mkOption {
      type = types.str;
      default = "/Users/${cfg.user}";
      defaultText = lib.literalExpression ''"/Users/''${user}"'';
      description = "Home folder on the Mac. This machine creates it, owned by programs.atomics.user.";
    };

    executables = mkOption {
      type = types.listOf types.str;
      default = [
        "${cfg.home}/Applications/ATOMICS.app/Contents/MacOS/atomics"
        "/Applications/ATOMICS.app/Contents/MacOS/atomics"
      ];
      defaultText = lib.literalExpression ''[ "''${home}/Applications/ATOMICS.app/Contents/MacOS/atomics" "/Applications/ATOMICS.app/Contents/MacOS/atomics" ]'';
      description = ''
        Paths of the ATOMICS binary on the Mac. Hook and MCP commands name the binary that started
        the agent; at each of these paths this machine runs its own `atomics` instead.
      '';
    };

    socket = mkOption {
      type = types.str;
      default = "${cfg.home}/.atomics/atomics.sock";
      defaultText = lib.literalExpression ''"''${home}/.atomics/atomics.sock"'';
      description = ''
        ATOMICS's control socket on the Mac. The opt-in forward recreates it here at the same path,
        and `ATOMICS_SOCKET` names it, so `atomics queue` and `atomics ctl` reach the Mac's ATOMICS.
        Forwarded, it makes this machine as trusted as the Mac account (docs/nixos-vm.md).
      '';
    };

    shares = mkOption {
      type = types.attrsOf (types.submodule {
        options.writable = mkOption {
          type = types.bool;
          default = false;
          description = "Whether this machine may write the folder.";
        };
      });
      default = {
        "${cfg.home}/repos".writable = true;
        "${cfg.home}/.atomics/briefs" = { };
      };
      defaultText = lib.literalExpression ''
        {
          "''${home}/repos".writable = true;    # repositories and their worktrees
          "''${home}/.atomics/briefs" = { };     # long task briefs ATOMICS writes for agents
        }
      '';
      description = ''
        Mac folders this machine mounts at the same paths over virtiofs, keyed by path. Agents can
        start only in these folders. Lima shares exactly these and nothing else of the Mac.
      '';
    };

    agents = mkOption {
      type = types.listOf (types.strMatching "[A-Za-z0-9._-]+");
      default = [ "claude" "codex" ];
      description = ''
        Programs the Mac gets a wrapper for, named like the program so ATOMICS recognizes it
        (codex hooks key on the name). Each runs the program of that name here.
      '';
    };

    forwardEnv = mkOption {
      type = types.listOf (types.strMatching "[A-Za-z_][A-Za-z0-9_]*");
      default = [ "TERM" "COLORTERM" "TERM_PROGRAM" "COLORFGBG" "ATOMICS_HOOK_PANE" ];
      description = ''
        Variables the wrappers pass from the Mac's terminal to the program here. Everything else
        comes from this machine's login environment; the Mac's PATH, job server, compiler cache
        and credential relay mean nothing here.
      '';
    };

    hostPort = mkOption {
      type = types.nullOr types.port;
      default = null;
      description = ''
        The port of the ATOMICS host running in this machine (atomics.vm.host), on its loopback. The
        bundle then gets bin/atomics-vm-host-forward, and its config snippet makes the Mac's ATOMICS
        a client of that host instead of starting agents here over ssh.
      '';
    };

    installDir = mkOption {
      type = types.str;
      default = "${cfg.home}/.local/share/atomics-vm";
      defaultText = lib.literalExpression ''"''${home}/.local/share/atomics-vm"'';
      description = "Where the Mac bundle is installed; its config snippet and launchd agent name this folder.";
    };

    lima = {
      instance = mkOption {
        type = types.strMatching "[A-Za-z0-9._-]+";
        default = "atomics";
        description = "Lima instance name; the wrappers reach it through Lima's ssh config.";
      };

      cidata = mkOption {
        type = types.str;
        default = "/mnt/lima-cidata";
        description = "Where this machine mounts Lima's cidata disk, which lists the virtiofs tags.";
      };

      settings = mkOption {
        type = yaml.type;
        default = { };
        description = "The Lima definition: VM size, image and VZ options. User and mounts are added.";
      };
    };

    bundle = mkOption {
      type = types.package;
      readOnly = true;
      description = ''
        The Mac side: wrappers in bin/, the opt-in socket forward and its launchd agent, lima.yaml,
        a config.d snippet and install.sh. Plain sh and macOS's ssh; it needs no Nix on the Mac.
      '';
    };
  };

  config = lib.mkIf (atomics.enable && cfg.enable) {
    programs.atomics.macDesktop.bundle = bundle;

    assertions = [
      {
        assertion = vmUser != null && vmUser.uid != null;
        message = "programs.atomics.macDesktop needs programs.atomics.user to name an existing user with a fixed uid";
      }
      {
        assertion = lib.all plainPath ([ cfg.home cfg.socket cfg.installDir ] ++ cfg.executables ++ map (share: share.path) shares);
        message = "programs.atomics.macDesktop paths must be absolute and use only letters, digits and ._@+-/";
      }
      {
        assertion = lib.all (path: !inShare path) ([ cfg.socket ] ++ cfg.executables);
        message = "programs.atomics.macDesktop: the socket and executables must not be inside a share";
      }
      {
        assertion = lib.all envName cfg.forwardEnv;
        message = "programs.atomics.macDesktop.forwardEnv must hold variable names";
      }
    ];

    environment.systemPackages = [ vmExec ];
    # The Mac's forwarded socket; the host in this machine (atomics.vm.host) names its own instead.
    environment.sessionVariables.ATOMICS_SOCKET = lib.mkDefault cfg.socket;
    # What this machine expects of the Mac, for scripts/check-atomics-vm.sh and diagnosis.
    environment.etc."atomics/mac-desktop.env".text = ''
      ATOMICS_MAC_SOCKET=${cfg.socket}
      ATOMICS_MAC_SHARES="${lib.concatMapStringsSep " " (share: "${share.path}:${if share.writable then "rw" else "ro"}") shares}"
      ATOMICS_MAC_EXECUTABLES="${lib.concatStringsSep " " cfg.executables}"
      ATOMICS_HOST_PORT=${if cfg.hostPort == null then "" else toString cfg.hostPort}
    '';

    # A forward that died leaves its socket file behind; the next one replaces it.
    services.openssh.settings.StreamLocalBindUnlink = true;

    systemd.tmpfiles.rules = lib.unique (
      map ownedDir (lib.filter (dir: dir != dirOf cfg.socket)
        (lib.unique (lib.concatMap parents ([ (dirOf cfg.socket) ] ++ cfg.executables) ++ [ cfg.home ])))
      ++ [ "d ${dirOf cfg.socket} 0700 ${atomics.user} ${vmGroup} - -" ]
      ++ map (exe: "L+ ${exe} - - - - ${atomics.package}/bin/atomics") cfg.executables
    );

    # Outside plain mode `limactl start` reports the VM degraded until Lima's guest agent answers.
    # It is Lima's own binary on the cidata disk, which mounts without exec permission. With every
    # port forward ignored it only reports readiness.
    systemd.services.lima-guestagent = {
      description = "Lima guest agent";
      wantedBy = [ "multi-user.target" ];
      unitConfig.RequiresMountsFor = [ cfg.lima.cidata ];
      path = [ pkgs.coreutils pkgs.gnused ];
      serviceConfig = {
        Restart = "on-failure";
        RestartSec = 5;
      };
      script = ''
        setting() { sed -n "s/^LIMA_CIDATA_$1=//p" ${cfg.lima.cidata}/lima.env; }
        vsock=$(setting VSOCK_PORT)
        virtio=$(setting VIRTIO_PORT)
        install -D -m 0755 ${cfg.lima.cidata}/lima-guestagent /run/lima-guestagent-bin/lima-guestagent
        if [ -n "$vsock" ] && [ "$vsock" != 0 ]; then
          set -- --vsock-port "$vsock"
        elif [ -n "$virtio" ]; then
          set -- --virtio-port "$virtio"
        fi
        exec /run/lima-guestagent-bin/lima-guestagent daemon --socket-owner "$(setting UID)" "$@"
      '';
    };

    # Lima names each virtiofs device itself and lists tag and mount point in cidata's user-data.
    systemd.services.atomics-mac-shares = {
      description = "Mount the Mac folders shared with ATOMICS agents";
      wantedBy = [ "multi-user.target" ];
      after = [ "systemd-tmpfiles-setup.service" ];
      unitConfig.RequiresMountsFor = [ cfg.lima.cidata ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      path = [ pkgs.coreutils pkgs.gawk pkgs.util-linux ];
      script = ''
        tag_of() {
          awk -v want="$1" '
            /^[[:space:]]*- \[/ {
              line = $0
              sub(/^[[:space:]]*- \[/, "", line)
              sub(/\][[:space:]]*$/, "", line)
              n = split(line, field, /, /)
              if (n >= 3 && field[2] == want && field[3] == "virtiofs") { print field[1]; exit }
            }' ${cfg.lima.cidata}/user-data
        }
        share() {
          local path=$1 mode=$2 tag
          tag=$(tag_of "$path")
          if [ -z "$tag" ]; then
            echo "Lima does not share $path; create the VM from the bundle's lima.yaml" >&2
            return 1
          fi
          mountpoint -q "$path" && return 0
          if [ ! -d "$path" ]; then
            mkdir -p "$path"
            chown ${atomics.user}:${vmGroup} "$path"
          fi
          mount -t virtiofs -o "$mode,nosuid,nodev" "$tag" "$path"
          echo "Mounted $tag at $path ($mode)"
        }
        status=0
        ${lib.concatMapStrings (share: ''
          share ${share.path} ${if share.writable then "rw" else "ro"} || status=1
        '') shares}
        exit "$status"
      '';
    };
  };
}
